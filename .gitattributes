# Normalize line endings
* text=auto

# Force LF for source files (cross-platform consistency)
*.py    text eol=lf
*.md    text eol=lf
*.csv   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
*.sh    text eol=lf

# SFD files: large text, keep LF
*.sfd   text eol=lf

# Binary files: never touch
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.tar   binary
*.gz    binary
*.pdf   binary

# Git diff hints for generated/binary
*.ttf   -diff
*.woff2 -diff